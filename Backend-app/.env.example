# ============================================
# Sistema Inventario Control
# Variables de Entorno
# ============================================

# Django
SECRET_KEY=your-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# Base de Datos
# ============================================

# Para desarrollo local con SQLite
USE_SUPABASE=False
USE_SQLITE=True

# Para Supabase / PostgreSQL (Producción recomendada)
# USE_SUPABASE=True
# USE_SQLITE=False
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=your_supabase_password
# SUPABASE_DB_HOST=db.xxxxxxxxxxxx.supabase.co
# SUPABASE_DB_PORT=5432

# Para SQL Server
# USE_SUPABASE=False
# USE_SQLITE=False
# DB_NAME=colmado_db
# DB_USER=sa
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=1433

# ============================================
# Redis
# ============================================

REDIS_URL=redis://localhost:6379/0

# ============================================
# JWT
# ============================================

ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ============================================
# CORS (orígenes permitidos separados por coma)
# ============================================

# Desarrollo (default — no hace falta definirlo)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Producción — agrega aquí el dominio real del frontend
# CORS_ALLOWED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com
# Copia este archivo como .env y completa los valores

SECRET_KEY=cambiar-por-una-clave-secreta-larga
DEBUG=True

# Base de datos — SQLite local (desarrollo)
USE_SQLITE=True

# Base de datos — SQL Server (producción)
# USE_SQLITE=False
# DB_NAME=colmado_db
# DB_USER=sa
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=1433

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (minutos / días)
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
